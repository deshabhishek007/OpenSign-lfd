<!DOCTYPE html>
<html>
  <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Reset your LDF Sign password</title>
  <style type='text/css'>
    * { box-sizing: border-box; }
    body { font-family: system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; background:#f5f3f3; margin:0; color:#222; }
    .wrap { max-width: 460px; margin: 6vh auto; padding: 0 16px; }
    .card { background:#fff; border:1px solid #ececec; border-radius:12px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,.06); }
    .bar { background:#7A1A1A; padding:16px 24px; }
    .wordmark { font-size:22px; font-weight:800; letter-spacing:-.3px; color:#fff; }
    .wordmark span { color:#D4AF37; }
    .body { padding: 26px 24px 30px; }
    h1 { font-size:20px; font-weight:700; margin:0 0 6px; color:#222; }
    .sub { font-size:13px; color:#777; margin:0 0 18px; }
    .error { color:#b91c1c; font-size:13px; margin:0 0 12px; }
    label.field { display:block; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#666; margin:14px 0 6px; }
    input[type=password] { width:100%; font-size:15px; padding:10px 12px; border:1px solid #d5d5d5; border-radius:7px; outline:none; color:#111; }
    input[type=password]:focus { border-color:#7A1A1A; box-shadow:0 0 0 3px rgba(122,26,26,.12); }
    #password_match_info { display:block; font-size:12px; color:#b91c1c; margin-top:6px; }
    button { margin-top:22px; width:100%; font-size:15px; font-weight:700; color:#fff; background:#7A1A1A; border:0; border-radius:7px; padding:12px 14px; cursor:pointer; }
    button:hover { background:#651414; }
    button:disabled { opacity:.5; cursor:not-allowed; }
    .foot { text-align:center; font-size:11px; color:#9a9a9a; margin-top:16px; }
    noscript { color:#b91c1c; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="bar"><span class="wordmark">LDF <span>Sign</span></span></div>
      <div class="body">
        <h1>Reset your password</h1>
        <p class="sub" id="subtitle">Choose a new password for your account.</p>
        <noscript>Resetting your password requires JavaScript to be enabled.</noscript>
        <div class='error' id='error'></div>
        <form id='form' action='#' method='POST'>
          <label class="field">New password</label>
          <input name="new_password" type="password" id="password"/>
          <label class="field">Confirm new password</label>
          <input name="confirm_new_password" type="password" id="password_confirm"/>
          <span id="password_match_info"></span>
          <input name='utf-8' type='hidden' value='&#10003;' />
          <input name="username" id="username" type="hidden" />
          <input name="token" id="token" type="hidden" />
          <button id="change_password">Change password</button>
        </form>
        <div class="foot">Legal Data Forensic Sign &middot; sign.legaldataforensic.com</div>
      </div>
    </div>
  </div>
<script language='javascript' type='text/javascript'>
  window.onload = function() {
    var urlParams = {};
    (function () {
        var pair,
            tokenize = /([^&=]+)=?([^&]*)/g,
            re_space = function (s) { return decodeURIComponent(s.replace(/\+/g, " ")); },
            querystring = window.location.search.substring(1);
        while (pair = tokenize.exec(querystring))
           urlParams[re_space(pair[1])] = re_space(pair[2]);
    })();

    var id = urlParams['id'];
    var base = PARSE_SERVER_URL;
    document.getElementById('form').setAttribute('action', base + '/apps/' + id + '/request_password_reset');
    document.getElementById('username').value = urlParams['username'] || '';
    var uname = urlParams['username'];
    if (uname && uname !== 'undefined') {
      document.getElementById('subtitle').appendChild(document.createTextNode(' (' + uname + ')'));
    }
    document.getElementById("password").oninput = validatePassword;
    document.getElementById("password_confirm").oninput = validatePassword;
    document.getElementById("change_password").disabled = true;
    document.getElementById('token').value = urlParams['token'];
    if (urlParams['error']) {
      document.getElementById('error').appendChild(document.createTextNode(urlParams['error']));
    }

    function validatePassword() {
      var pass2 = document.getElementById("password").value;
      var pass1 = document.getElementById("password_confirm").value;
      if(pass1 !== pass2) {
        if(document.getElementById("password_confirm").value) {
          document.getElementById("change_password").disabled = true;
          document.getElementById("password_match_info").innerHTML = "Passwords must match";
        }
      } else {
        document.getElementById("change_password").disabled = false;
        document.getElementById("password_match_info").innerHTML = "";
      }
    }
  }
</script>
</body>
</html>
